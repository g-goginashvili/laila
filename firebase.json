{
	"hosting": [
		{
			"target": "laila",
			"public": "dist",
			"ignore": [
				"firebase.json",
				"**/.*",
				"**/node_modules/**"
			],
			"rewrites": [
				{
					"source": "**",
					"destination": "/index.html"
				}
			]
		},
		{
			"target": "gviano",
			"public": "dist",
			"ignore": [
				"firebase.json",
				"**/.*",
				"**/node_modules/**"
			],
			"rewrites": [
				{
					"source": "**",
					"destination": "/index.html"
				}
			]
		}
	],
	"emulators": {
		"auth": {
			"port": 9099
		},
		"hosting": {
			"port": 5657
		},
		"ui": {
			"enabled": true,
			"port": 4000
		},
		"singleProjectMode": true
	},
	"auth": {
		"providers": {
			"emailPassword": true
		}
	}
}